---
import Base from "../layouts/Base.astro";
import { site } from "../config";
import { getBooks, bookUrl } from "../lib/content";

// 出版年表由書籍資料自動生成(規格書 4.6),依年份倒序分組,標明作者
const books = await getBooks();
const years = [...new Set(books.map((b) => b.data.publish_date.getUTCFullYear()))];
---
<Base title="關於工作室與作者" description="工作室介紹、兩位作者簡介、創作理念與出版年表。">
  <h1>關於{site.title}</h1>

  <div class="about-intro">
    <p>(工作室介紹一段:成立緣起、創作方向、兩位作者如何分工合作。)</p>
  </div>

  <h2>作者</h2>
  <section class="about-author" aria-label={site.authors[0]}>
    <h3>{site.authors[0]}</h3>
    <p>(作者簡介 300–500 字。請介紹創作背景、養成經歷、關注的主題。)</p>
    <p>(創作理念:例如圖像創作——談繪本的圖像語言、媒材與說故事的方式。)</p>
  </section>
  <section class="about-author" aria-label={site.authors[1]}>
    <h3>{site.authors[1]}</h3>
    <p>(作者簡介 300–500 字。請介紹創作背景、養成經歷、關注的主題。)</p>
    <p>(創作理念:例如文字創作——談童話、少年小說與詩的關注主題與語言追求。)</p>
  </section>

  <h2>出版年表</h2>
  <ul class="pub-timeline">
    {years.map((y) => (
      <li>
        <strong>{y}</strong>
        {books
          .filter((b) => b.data.publish_date.getUTCFullYear() === y)
          .map((b) => (
            <span class="pub-item">
              <a href={bookUrl(b)}>《{b.data.title}》</a>({b.data.author.join("、")},{b.data.category})
            </span>
          ))}
      </li>
    ))}
  </ul>

  <h2>得獎與入選</h2>
  <ul>
    <li>(選填。年份+獎項或入選紀錄,標明作者;無則整段刪除。)</li>
  </ul>
</Base>
